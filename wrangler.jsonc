{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "therapy-search",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-27",
  "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/assets/*"] },
  // Cached answers outlive a deploy; LOOKUP_VERSION in shared/location.ts retires lookup answers a change makes wrong.
  // Covers both entrypoints. Visitors' searches are POSTs, which are never cached, so the default entrypoint runs for each
  // one and its cache holds only built files; CachedApi's holds the answers, keyed on canonical URLs.
  "cache": { "enabled": true, "cross_version_cache": true },
  "ratelimits": [
    { "name": "UPSTREAM_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "PLACE_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "OFFICE_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  // UKCP's anti-forgery session, shared by every isolate.
  "kv_namespaces": [{ "binding": "UKCP_SESSION", "id": "0d58d3e6b9c14526b49ed5b8c371b6a1" }],
  "vars": { "SITE_URL": "https://therapy-search.babissimo.workers.dev" },
  "observability": { "enabled": false }
}
